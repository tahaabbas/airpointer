<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: controls on the left (compact buttons, keyboard bar, multi-line shortcuts), touchpad on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="42"
        android:orientation="vertical">

        <include layout="@layout/remote_toolbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <include layout="@layout/remote_mouse_buttons" />
        </LinearLayout>

        <include
            layout="@layout/remote_keyboard_line"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <!-- Shortcut buttons wrap onto as many lines as fit, and scroll when there are more -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:scrollbarSize="3dp">

            <com.airpointer.remote.FlowLayout
                android:id="@+id/quickKeys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
    </LinearLayout>

    <!-- Screen view (computer screen) sits behind the touchpad, which turns translucent over it -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="58">

        <!-- Screen layer: H.264 video (TextureView; stays visible so its surface exists) with the cursor/JPEG overlay on top -->
        <FrameLayout
            android:id="@+id/screenLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone">

            <TextureView
                android:id="@+id/screenVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.airpointer.remote.ScreenView
                android:id="@+id/screenView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <com.airpointer.remote.TouchpadView
            android:id="@+id/touchpad"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <com.airpointer.remote.ScrollStripView
        android:id="@+id/scrollStrip"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp" />
</LinearLayout>
