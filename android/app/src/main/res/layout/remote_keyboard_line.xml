<?xml version="1.0" encoding="utf-8"?>
<!-- "Keyboard" bar: a button that turns into a text box + Send while typing -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp">

    <!-- Invisible receiver for live typing from the phone keyboard -->
    <com.airpointer.remote.KeyCaptureView
        android:id="@+id/keyCapture"
        android:layout_width="1dp"
        android:layout_height="1dp" />

    <Button
        android:id="@+id/btnKeyboardBar"
        style="@style/ShortcutBtn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="Keyboard" />

    <LinearLayout
        android:id="@+id/keyboardRow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/textInput"
            style="@style/Input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Type, then Send"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />

        <Button
            android:id="@+id/btnSend"
            style="@style/ShortcutBtn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Send"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
