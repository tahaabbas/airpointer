<?xml version="1.0" encoding="utf-8"?>
<!-- A button in the shortcut editor list: drag handle, icon, name, edit, delete -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/handle"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:contentDescription="Drag to move"
        android:scaleType="center"
        android:src="@drawable/lic_grip_vertical"
        android:tint="@color/text_muted" />

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:tint="@color/accent_light" />

        <TextView
            android:id="@+id/iconText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="Aa"
            android:textColor="@color/accent_light"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/edit"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_ghost"
        android:contentDescription="Edit"
        android:scaleType="center"
        android:src="@drawable/lic_pencil"
        android:tint="@color/text" />

    <ImageButton
        android:id="@+id/delete"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_ghost"
        android:contentDescription="Remove"
        android:scaleType="center"
        android:src="@drawable/lic_trash_2"
        android:tint="@color/error" />
</LinearLayout>
